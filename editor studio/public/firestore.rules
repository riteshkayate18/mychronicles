rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'riteshkayate18@gmail.com';
    }

    // Orders: Users can create and read their own, Admin can do anything
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.uid == resource.data.user_id || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Products: Everyone can read, Admin can update
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: Admin only
    match /users/{userId} {
      allow read, write: if isAdmin();
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}