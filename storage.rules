rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /orders/{fileName} {
      allow write: if request.auth != null;
      allow read: if request.auth != null && (request.auth.token.email == 'riteshkayate18@gmail.com' || fileName.matches(request.auth.uid + '.*'));
    }
  }
}
